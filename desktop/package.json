{
  "name": "moloptima-desktop",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tprytkov/moloptima.git"
  },
  "description": "Phase 5A Electron desktop launcher for MolOptima.",
  "main": "main.js",
  "scripts": {
    "test:lifecycle": "node --test lifecycle.test.js",
    "build:frontend": "cd ../frontend && npm.cmd run build",
    "dev": "electron .",
    "start": "electron .",
    "package": "npm run build:frontend && electron-builder --win dir",
    "dist": "npm run build:frontend && electron-builder --win nsis-web"
  },
  "build": {
    "appId": "local.moloptima.desktop",
    "productName": "MolOptima",
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "lifecycle.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      },
      {
        "from": "../backend",
        "to": "moloptima-app/backend",
        "filter": [
          "**/*",
          "!uploads/**",
          "!job_outputs/**",
          "!job_metadata/**",
          "!job_annotations/**",
          "!__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../molecular_prioritization",
        "to": "moloptima-app/molecular_prioritization",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../biopharma_intelligence",
        "to": "moloptima-app/biopharma_intelligence",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../data",
        "to": "moloptima-app/data"
      },
      {
        "from": "../app_data",
        "to": "moloptima-app/app_data",
        "filter": [
          "**/.gitkeep",
          "model_resources/admet/**/*"
        ]
      },
      {
        "from": "../resources",
        "to": "moloptima-app/resources",
        "filter": [
          "admet/runtime_manifest.json",
          "admet/runners/**/*",
          "vina/**/*",
          "openbabel/**/*",
          "prioritization_profiles/**/*",
          "receptor_preparation/runtime_manifest.json",
          "runtime/vina/**/*",
          "runtime/openbabel/**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "dir",
        "nsis-web"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
