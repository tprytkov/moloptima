          "lower": 1,
          "upper": 3,
          "lower_width": 1,
          "upper_width": 1
        }
      },
      "weight": 1,
      "required": false,
      "missing_policy": "renormalize_with_warning",
      "uncertainty_policy": "warning_only",
      "notes": "First-profile literature-informed moderate logD target: full desirability from 1.0 to 3.0, declining to zero at 0.0 and 4.0."
