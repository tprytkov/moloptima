        "type": "identity_01",
        "params": {}
      },
      "weight": 1,
      "required": true,
      "missing_policy": "unrankable",
      "uncertainty_policy": "warning_only",
      "notes": "Required minimum finite Vina mode affinity, normalized only within the generated campaign; optional reference delta is explanatory only."
