      },
      "weight": 1,
      "required": false,
      "missing_policy": "renormalize_with_warning",
      "uncertainty_policy": "warning_only",
      "notes": "Literature-informed log10 Papp cm/s anchors: zero desirability at -6.0 and plateau at approximately -5.15."
