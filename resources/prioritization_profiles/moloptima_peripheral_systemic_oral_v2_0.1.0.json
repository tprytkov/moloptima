      "weight": 1,
      "required": false,
      "missing_policy": "renormalize_with_warning",
      "uncertainty_policy": "warning_only",
      "notes": "Bounded model score for the greater-than-30-percent-absorbed class; not percent intestinal absorption."
    },
    "Caco2_Wang": {
      "enabled": true,
      "role": "objective",
      "domain": "absorption",
      "transform": {
        "type": "minimum_plateau",
