      "weight": 1,
      "required": false,
      "missing_policy": "warning_only",
      "uncertainty_policy": "warning_only",
      "notes": "Soft liability for projects explicitly seeking limited CNS exposure. Raw five-seed output is not quantitative brain exposure or Kp,uu,brain; threshold_status=provisional_raw and calibration_status=not_frozen."
    },
    "Lipophilicity_AstraZeneca": {
      "enabled": true,
      "role": "objective",
